# Base stage with dependencies
FROM python:3.11-slim-bookworm@sha256:9c6f90801e6b68e772b7c0ca74260cbf7af9f320acec894e26fccdaccfbe3b47 AS base

ENV AETHERSEARCH_RUNNING_IN_DOCKER="true" \
    HF_HOME=/app/.cache/huggingface

COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /uvx /bin/

RUN mkdir -p /app/.cache/huggingface

COPY ./requirements/model_server.txt /tmp/requirements.txt

# Install torch + CUDA/GPU deps in a dedicated layer: together they are ~3GB,
# and isolating them avoids a single oversized layer that is unreliable to push.
RUN grep -E '^(torch|nvidia-[a-z0-9-]+|triton)==' /tmp/requirements.txt \
        | uv pip install --system --no-cache-dir -r /dev/stdin && \
    rm -rf ~/.cache/uv

RUN uv pip install --system --no-cache-dir \
        -r /tmp/requirements.txt && \
    rm -rf ~/.cache/uv /tmp/*.txt

# Stage for downloading embedding models
FROM base AS embedding-models
RUN python -c "from huggingface_hub import snapshot_download; \
snapshot_download('nomic-ai/nomic-embed-text-v1');"

# Initialize SentenceTransformer to cache the custom architecture
RUN python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer(model_name_or_path='nomic-ai/nomic-embed-text-v1', trust_remote_code=True);"

# Final stage - combine all downloads
FROM base AS final

LABEL com.danswer.maintainer="founders@aethersearch.app"
LABEL com.danswer.description="This image is for the AetherSearch model server which runs all of the \
AI models for AetherSearch. This container and all the code is MIT Licensed and free for all to use. \
You can find it at https://hub.docker.com/r/aethersearch/aethersearch-model-server. For more details, \
visit https://github.com/aethersearch-dot-app/aethersearch."

# Create non-root user for security best practices
RUN groupadd -g 1001 aethersearch && \
    useradd -u 1001 -g aethersearch -m -s /bin/bash aethersearch && \
    mkdir -p /var/log/aethersearch && \
    chmod 755 /var/log/aethersearch && \
    chown aethersearch:aethersearch /var/log/aethersearch

# In case the user has volumes mounted to /app/.cache/huggingface that they've downloaded while
# running AetherSearch, move the current contents of the cache folder to a temporary location to ensure
# it's preserved in order to combine with the user's cache contents
COPY --chown=aethersearch:aethersearch --from=embedding-models /app/.cache/huggingface /app/.cache/temp_huggingface

WORKDIR /app

# Utils used by model server
COPY ./aethersearch/utils/logger.py /app/aethersearch/utils/logger.py
COPY ./aethersearch/utils/platform.py /app/aethersearch/utils/platform.py
COPY ./aethersearch/utils/middleware.py /app/aethersearch/utils/middleware.py
COPY ./aethersearch/utils/tenant.py /app/aethersearch/utils/tenant.py

# Sentry configuration (used when SENTRY_DSN is set)
COPY ./aethersearch/configs/__init__.py /app/aethersearch/configs/__init__.py
COPY ./aethersearch/configs/sentry.py /app/aethersearch/configs/sentry.py

# Place to fetch version information
COPY ./aethersearch/__init__.py /app/aethersearch/__init__.py

# Shared between AetherSearch Backend and Model Server
COPY ./shared_configs /app/shared_configs

# Model Server main code
COPY ./model_server /app/model_server

ENV PYTHONPATH=/app

# Default AETHERSEARCH_VERSION, typically overriden during builds by GitHub Actions.
ARG AETHERSEARCH_VERSION=0.0.0-dev
ENV AETHERSEARCH_VERSION=${AETHERSEARCH_VERSION}

CMD ["uvicorn", "model_server.main:app", "--host", "0.0.0.0", "--port", "9000"]
